# Production settings for docker-compose.yml (issue #20). Copy to deploy/.env.production, fill in the empty
# values (docs/DEPLOYMENT.md shows how to generate them) and never commit the copy. One NAME=value per line,
# without quotes.

# --- Address (deploy/Caddyfile) ---
# Domain name for a public HTTPS certificate, or localhost for a local test with a locally trusted certificate.
SITE_ADDRESS=localhost

# --- App (backend/src/config.py) ---
# Always production on the server: no debug, Secure cookies, no CORS origin.
APP_ENV=production
# Debug mode; refused in production.
FLASK_DEBUG=false
# Leave empty: the frontend and the API share one origin, so no other origin is allowed.
CORS_ORIGINS=
# Secret. Signs the session cookie; 64 hex characters.
FLASK_SECRET_KEY=
# Secret. Key for the customer references in URLs and the audit log; at least 32 characters.
CUSTOMER_REF_KEY=
# The session cookie is sent over HTTPS only.
SESSION_COOKIE_SECURE=true
# Lax or Strict.
SESSION_COOKIE_SAMESITE=Lax
# Minutes until a signed in session ends.
SESSION_LIFETIME_MINUTES=60
# Caddy sets X-Forwarded-For and X-Forwarded-Proto, so the API reads the client address from them.
TRUST_PROXY=true
# Rate limiter storage; memory:// counts per process, which is correct with one Gunicorn worker.
RATELIMIT_STORAGE_URI=memory://
# Gunicorn worker processes; keep 1 with memory:// (each worker has 4 threads).
WEB_CONCURRENCY=1

# --- Database (backend/src/db.py) ---
# Database role; the db service creates it on its first start.
DB_USER=salesmesh
# Secret. Database password; hex characters avoid any quoting problem.
DB_PASSWORD=
# db for the db service in docker-compose.yml, or the host name of an outside database.
DB_HOST=db
# Database port.
DB_PORT=5432
# Database name; the db service creates it on its first start.
DB_NAME=salesmesh_fraud_detection
# Empty for the db service; require (or verify-full) for an outside database.
DB_SSLMODE=
# false when the database already exists and the role may not create databases (most managed services).
DB_CREATE_DATABASE=true

# --- Detection scheduler (backend/src/scheduler.py) ---
# docker-compose.yml sets both for the scheduler service and takes precedence; change them there.
DETECTION_INTERVAL_MINUTES=1440
# Run once immediately when the scheduler starts.
DETECTION_RUN_ON_START=true
