# Reverse proxy image (issue #20): the built frontend served by Caddy. Build from the repository root:
#   docker build -f deploy/Dockerfile.proxy -t salesmesh-proxy .

FROM node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# VITE_API_BASE stays unset, so the app calls /api on its own origin.
RUN npm run build

FROM caddy:2.11-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv
