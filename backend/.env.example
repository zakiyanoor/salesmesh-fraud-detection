# Backend settings (issue #26). Copy to backend/.env and fill in the empty values.
# backend/.env is gitignored: never commit real passwords or keys.

# --- App (src/config.py) ---
# development, test or production. Unset means production: no debug, Secure cookies, no CORS origin.
APP_ENV=development
# Debug mode; refused when APP_ENV is production.
FLASK_DEBUG=false
# Comma-separated browser origins allowed to call the API with credentials ("*" is refused).
# Default: http://localhost:5173 in development and test, none in production.
CORS_ORIGINS=http://localhost:5173
# Session cookie. HttpOnly is always on. Secure defaults to true, and to false in development and test.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=60
# Signs the session cookie. Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Key for the customer references used in URLs and the audit log instead of customer IDs (issue #28).
# At least 32 characters. Required in production; development and test use a random key per process
# if it is empty. Never logged. Generate one with the same command as above.
CUSTOMER_REF_KEY=

# --- Database (src/db.py) ---
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salesmesh_fraud_detection

# --- Detection scheduler (src/scheduler.py) ---
DETECTION_INTERVAL_MINUTES=1440
DETECTION_RUN_ON_START=true

# --- Demo accounts (python -m src.auth; development and test only) ---
# analyst_01, compliance_01 and admin_01. At least 12 characters each. The backend tests use them too.
DEMO_ANALYST_PASSWORD=
DEMO_COMPLIANCE_PASSWORD=
DEMO_ADMIN_PASSWORD=
